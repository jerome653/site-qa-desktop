# --- dependencies (reinstall with `npm install`) ---
node_modules/
engine/node_modules/

# --- bundled Playwright Chromium (~685MB) — reinstall on a new machine, never commit ---
#     see DEV-HANDOFF.md "Set up on a new machine" for how to repopulate this folder
browsers/

# --- build outputs (regenerated by `npm run dist`) ---
release/
release-*/
dist-share/

# --- runtime scan data, reports, logs ---
sgen/
engine/**/_ui-runs/
*.log
*.local

# --- OS / editor cruft ---
Thumbs.db
.DS_Store
.vscode/
