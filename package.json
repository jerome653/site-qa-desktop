{
  "name": "sgen-site-qa-desktop",
  "productName": "Site Audit",
  "version": "6.2.1",
  "description": "Site Audit — developer-first website quality auditing, as a desktop app.",
  "main": "main.js",
  "author": "SGEN",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "node smoke.js",
    "dist": "electron-builder --win nsis --x64",
    "publish": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sgen.siteqa",
    "productName": "Site Audit",
    "publish": [
      {
        "provider": "github",
        "owner": "jerome653",
        "repo": "migration-qa"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "README.html",
        "to": "README.html"
      },
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/*.test.js",
          "!**/_ui-runs/**",
          "!**/.github/**"
        ]
      },
      {
        "from": "browsers",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico"
    }
  }
}
