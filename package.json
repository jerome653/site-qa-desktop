{
  "name": "sgen-site-qa-desktop",
  "productName": "SGEN Site QA",
  "version": "2.5.3",
  "description": "SGEN Site QA — developer-first website quality auditing, as a desktop app.",
  "main": "main.js",
  "author": "SGEN",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "node smoke.js",
    "dist": "electron-builder --win nsis --x64",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "publish": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sgen.siteqa",
    "productName": "SGEN Site QA",
    "publish": [
      {
        "provider": "github",
        "owner": "docssgen-admin",
        "repo": "migration-qa"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/*.test.js",
          "!**/_ui-runs/**"
        ]
      },
      {
        "from": "browsers",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName} ${version} (arm64).${ext}",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName} ${version} (arm64).${ext}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
